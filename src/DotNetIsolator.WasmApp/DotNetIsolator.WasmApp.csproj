<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifier>wasi-wasm</RuntimeIdentifier>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<InvariantGlobalization>true</InvariantGlobalization>
		<InvariantTimezone>true</InvariantTimezone>
		<WasmBuildNative>true</WasmBuildNative>
		<WasmSingleFileBundle>true</WasmSingleFileBundle>
		<WasmInitialHeapSize>134217728</WasmInitialHeapSize>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MessagePack" Version="3.1.6" />
	</ItemGroup>

	<ItemGroup>
		<Compile Include="..\DotNetIsolator.Guest\GuestToHostCall.cs" />
		<Compile Include="..\DotNetIsolator.Guest\MessagePackCompatibility.cs" />
		<Compile Include="..\DotNetIsolator.Guest\ObjectGraphObjectSerializer.cs" />
		<Compile Include="..\DotNetIsolator.Guest\ObjectGraphPrimitiveCollections.cs" />
		<Compile Include="..\DotNetIsolator.Guest\ObjectGraphPrimitives.cs" />
		<Compile Include="..\DotNetIsolator.Guest\ObjectGraphSerializer.cs" />
		<Compile Include="..\DotNetIsolator.Guest\ObjectGraphTypes.cs" />
		<Compile Include="..\DotNetIsolator.Guest\generated\MessagePackGenerated.cs" />
	</ItemGroup>

	<ItemGroup>
		<WasiAfterRuntimeLoadedDeclarations Include="void dotnetisolator_add_assembly_search_hook()%3B" />
		<WasiAfterRuntimeLoadedDeclarations Include="void dotnetisolator_add_host_callback_internal_calls()%3B" />
		<WasiAfterRuntimeLoadedCalls Include="dotnetisolator_add_assembly_search_hook()%3B" />
		<WasiAfterRuntimeLoadedCalls Include="dotnetisolator_add_host_callback_internal_calls()%3B" />
		<LinkerArg Include="-Wl,--skip-wit-component" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_deserialize_object" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_instantiate_class" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_byte_array" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_blittable_array" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_blittable_list" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_blittable_array_arg" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_i32_packed" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_i32_i32" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_i32_i32_packed" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_scalar" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_void" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_i32_void" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_invoke_method" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_lookup_method" />
		<LinkerArg Include="-Wl,--export=dotnetisolator_release_object" />
	</ItemGroup>

	<Target Name="CompileDotNetIsolatorNativeSources" BeforeTargets="_WasiWriteRspForLinking">
		<ItemGroup>
			<_DotNetIsolatorNativeSource Include="native\assembly_search_hook.c" ObjectFile="$(_WasmIntermediateOutputPath)assembly_search_hook.o" />
			<_DotNetIsolatorNativeSource Include="native\dotnetisolate.c" ObjectFile="$(_WasmIntermediateOutputPath)dotnetisolate.o" />
			<_DotNetIsolatorNativeSource Include="native\host_callback.c" ObjectFile="$(_WasmIntermediateOutputPath)host_callback.o" />
		</ItemGroup>

		<EmccCompile
			SourceFiles="@(_DotNetIsolatorNativeSource)"
			Arguments="&quot;@$(_WasmDefaultFlagsRsp)&quot; &quot;@$(_WasmCompileRsp)&quot;"
			CompilerBinaryPath="$(WasmClang)"
			EnvironmentVariables="@(WasmToolchainEnvVars)"
			DisableParallelCompile="$(DisableParallelEmccCompile)"
			MessageToIndicateCompiling="Compiling DotNetIsolator native sources with $(WasmClang) ..."
			OutputMessageImportance="$(_EmccCompileOutputMessageImportance)">
			<Output TaskParameter="OutputFiles" ItemName="FileWrites" />
		</EmccCompile>

		<ItemGroup>
			<_WasmNativeFileForLinking Include="%(_DotNetIsolatorNativeSource.ObjectFile)" />
		</ItemGroup>
	</Target>

</Project>
